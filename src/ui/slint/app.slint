// FastCarPlay built-in screens (Slint, software renderer, RGB565 overlay).
//
// Pure declarative UI: every behavior goes through the Bridge global --
// properties flow app -> UI (set from slint_osd.cpp on change only),
// callbacks flow UI -> app. Validation and persistence stay in C++.
//
// Layout follows the screens it replaces (docs/ui.md): fixed-height
// touch rows (never a fraction of the screen), 800x480 panel metrics
// (row 80 px, gap 8 px, 20 px text), colors from the old ui_style.
//
// Input: touch everywhere; a Bluetooth keyboard moves an amber focus ring
// over the rows (Up/Down), activates (Enter), goes back (Esc/Backspace) and
// types into the editor -- all fed from C++ (slint_osd.cpp). Everything is
// also reachable with a rotary knob alone (turn = next/previous, press =
// activate): every screen starts with a Back row, and the editor's keys and
// the dialogs' buttons take the ring too.

import "fonts/font.ttf";

// One Bluetooth device in a list. `id` is the BlueZ object path: callbacks
// carry it rather than a row index, because a row can move between a tap's
// press and its release.
export struct BtRow {
    id: string,
    name: string,
    detail: string,
    connected: bool,
}

export global Bridge {
    // app -> UI
    in property <string> status;              // connection state line
    in property <string> source-label;        // short label of the active source
    in property <bool> session-waiting;       // backgrounded session behind the UI
    in property <bool> restart-needed;        // a staged change awaits a restart
    in property <int> protocol;               // active source id (radio list)
    in property <string> night-label;         // "Day" / "Night" / "Auto"
    in property <string> fps-label;           // "30 fps" / "60 fps"
    in property <string> volume-label;        // "60%" / "Muted"
    in property <int> volume-level;           // 0..100
    in property <bool> volume-muted;
    in property <bool> volume-bar;            // up for a moment after a change
    // How the phone is connected right now (the Home screen's icons).
    in property <bool> link-usb;
    in property <bool> link-wifi;
    in property <bool> link-bt;
    // The camera (Settings > Video); levels as "40%", "" without the control.
    in property <bool> camera-available;
    in property <string> camera-input-label;
    in property <string> camera-standard-label;
    in property <string> camera-brightness-label;
    in property <string> camera-contrast-label;
    in property <string> camera-saturation-label;
    in property <string> camera-error;        // why Test camera could not run
    in property <bool> camera-hint;           // "tap to close", for a moment
    in property <string> wifi-ssid;
    in property <string> wifi-pass;
    in property <string> bt-name;
    in property <int> editing;                // field id being edited, -1 = none
    in property <string> editor-label;        // what is being edited ("Name"...)
    in property <string> editor-text;         // the edit buffer (owned by C++)
    in property <string> editor-error;        // non-empty = red validation hint

    // Bluetooth devices (keyboards, remotes); all text composed in C++.
    in property <bool> bt-available;          // built with Bluetooth support
    in property <string> bt-summary;          // Wireless > Bluetooth row value
    in property <string> bt-status;           // header suffix ("Searching...")
    in property <bool> bt-scanning;
    in property <bool> bt-scan-allowed: true; // false during a wireless phone session
    in property <[BtRow]> bt-paired;
    in property <[BtRow]> bt-found;
    in property <BtRow> bt-current;           // the device screen's device

    // A dialog over everything: 0 none, 1 a code to type on the device
    // (Cancel only), 2 a yes/no question.
    in property <int> prompt-kind;
    in property <string> prompt-title;
    in property <string> prompt-code;
    in property <string> prompt-hint;
    in property <string> prompt-accept-label;
    in property <int> prompt-focus: -1;      // keyboard ring: 0 accept, 1 Cancel, -1 none
    // Which volume button has the keyboard ring: 0 "-", 1 "+", -1 neither
    // (so Left/Right can move between them).
    in-out property <int> stepper-focus: -1;
    // The ring's row when it is one that can go away while its screen stays
    // (the Resume row, a Bluetooth device), "" otherwise: a removed row never
    // reports losing focus, so C++ watches for it and puts the ring back.
    in-out property <string> ring-row;

    // Navigation, shared so C++ can follow it (discovery runs only while a
    // Bluetooth screen is up) and drive it (the Home key).
    // 0 home, 1 settings, 2 source, 3 wireless, 4 bluetooth, 5 bt device,
    // 6 audio, 7 system, 8 video, 9 camera (Test camera, full screen)
    in-out property <int> screen;

    // UI -> app
    callback select-protocol(int);
    callback resume();
    callback restart-now();
    callback cycle-night();
    callback cycle-fps();
    callback volume-step(int);                // -1 quieter, +1 louder
    callback volume-mute();                   // toggle
    callback system-ask(int);                 // 1 reboot, 2 shut down: asks first
    callback camera-cycle-input();
    callback camera-cycle-standard();
    callback camera-step(int, int);           // 0 brightness, 1 contrast, 2 saturation; -1/+1
    callback edit-field(int);                 // open the editor on a field
    callback osk-key(string);                 // literal character
    callback osk-backspace();
    callback osk-ok();                        // validate + save (C++ closes)
    callback osk-cancel();
    callback bt-scan(bool);
    callback bt-pair(string);
    callback bt-open(string);
    callback bt-connect(string, bool);
    callback bt-forget(string);
    callback prompt-accept();
    callback prompt-cancel();
}

// ── on-screen keyboard ───────────────────────────────────────────────────
// The editor's keyboard: layout, shift/symbols and the keyboard focus ring.
// A global, because the editor itself comes and goes: C++ moves the ring
// with the arrows of a keyboard or remote and presses the ringed key on
// Enter/OK, so a remote with no letters can type too. Touch never shows it.
export global Osk {
    in-out property <bool> shift;
    in-out property <bool> symbols;
    // The ring: row -1 none, 0 Cancel, 1-3 the key rows, 4 the bottom row;
    // col counts that row's keys from the left, as laid out in Editor.
    in-out property <int> row: -1;
    in-out property <int> col;

    out property <[string]> r1: root.symbols ? ["1","2","3","4","5","6","7","8","9","0"]
        : root.shift ? ["Q","W","E","R","T","Y","U","I","O","P"]
                     : ["q","w","e","r","t","y","u","i","o","p"];
    out property <[string]> r2: root.symbols ? ["!","@","#","$","%","^","&","*","(",")"]
        : root.shift ? ["A","S","D","F","G","H","J","K","L"]
                     : ["a","s","d","f","g","h","j","k","l"];
    out property <[string]> r3: root.symbols ? ["-","_","+","=",";",":","'","\"","/","?"]
        : root.shift ? ["Z","X","C","V","B","N","M"]
                     : ["z","x","c","v","b","n","m"];
    // Row 3 starts with Shift in letter mode; row 4 has the backtick key in
    // symbol mode.
    out property <int> r3-first: root.symbols ? 0 : 1;
    out property <int> r4-extra: root.symbols ? 1 : 0;

    function count(r: int) -> int {
        if (r == 0) {
            return 1;
        }
        if (r == 1) {
            return root.r1.length;
        }
        if (r == 2) {
            return root.r2.length;
        }
        if (r == 3) {
            return root.r3-first + root.r3.length + 1;
        }
        return 5 + root.r4-extra;
    }

    // A fresh editor: letters, no ring.
    public function reset() {
        root.shift = false;
        root.symbols = false;
        root.row = -1;
        root.col = 0;
    }

    // An arrow key. The first one only shows the ring, on the first letter.
    public function move(dx: int, dy: int) {
        if (root.row < 0) {
            root.row = 1;
            root.col = 0;
            return;
        }
        if (dy != 0 && root.row + dy >= 0 && root.row + dy <= 4) {
            // Cancel sits top right; between key rows keep the same share
            // of the width.
            root.col = root.row + dy == 0 ? 0
                : root.row == 0 ? count(root.row + dy) - 1
                : Math.min(count(root.row + dy) - 1,
                           Math.floor((root.col + 0.5) * count(root.row + dy) / count(root.row)));
            root.row = root.row + dy;
        }
        root.col = Math.max(0, Math.min(count(root.row) - 1, root.col + dx));
    }

    // One rotary detent: the ring walks every key in reading order --
    // Cancel, the key rows, the bottom row ending in OK -- and wraps around.
    // The first one only shows the ring, on the first letter.
    public function step(d: int) {
        if (root.row < 0) {
            root.row = 1;
            root.col = 0;
            return;
        }
        root.col = Math.max(0, Math.min(count(root.row) - 1, root.col));
        if (d > 0) {
            if (root.col + 1 < count(root.row)) {
                root.col += 1;
            } else {
                root.row = root.row == 4 ? 0 : root.row + 1;
                root.col = 0;
            }
        } else if (d < 0) {
            if (root.col > 0) {
                root.col -= 1;
            } else {
                root.row = root.row == 0 ? 4 : root.row - 1;
                root.col = count(root.row) - 1;
            }
        }
    }

    // Enter/OK on the ringed key: the same as tapping it.
    public function activate() {
        root.col = Math.max(0, Math.min(count(root.row) - 1, root.col));
        if (root.row == 0) {
            Bridge.osk-cancel();
        } else if (root.row == 1) {
            Bridge.osk-key(root.r1[root.col]);
        } else if (root.row == 2) {
            Bridge.osk-key(root.r2[root.col]);
        } else if (root.row == 3) {
            if (root.col < root.r3-first) {
                root.shift = !root.shift;
            } else if (root.col < root.r3-first + root.r3.length) {
                Bridge.osk-key(root.r3[root.col - root.r3-first]);
            } else {
                Bridge.osk-backspace();
            }
        } else if (root.row == 4) {
            if (root.col == 0) {
                root.symbols = !root.symbols;
                root.shift = false;
            } else if (root.col < 1 + root.r4-extra) {
                Bridge.osk-key("`");
            } else if (root.col == 1 + root.r4-extra) {
                Bridge.osk-key(",");
            } else if (root.col == 2 + root.r4-extra) {
                Bridge.osk-key(" ");
            } else if (root.col == 3 + root.r4-extra) {
                Bridge.osk-key(".");
            } else {
                Bridge.osk-ok();
            }
        }
    }
}

// ── shared look ──────────────────────────────────────────────────────────
global Style {
    out property <color> bg: #101418;
    out property <color> row: #1E262E;
    out property <color> row-pressed: #2C3844;
    out property <color> row-on: #1E88E5;
    out property <color> edge: #64B5F6;
    out property <color> focus: #FFB300;
    out property <color> dim: #8FA3B0;
    out property <color> text: #E8Eef2;
    out property <length> gap: 8px;
    out property <length> row-h: 80px;
    out property <length> font: 20px;
}

// A touch row: label, optional right-aligned value, pressed/selected states.
// Keyboard focus shows as an amber ring, distinct from the blue "selected"
// fill. Rows never take focus from a tap (focus-on-click false), so touch use
// is unchanged and never shows a ring.
component Row inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    in property <string> ring-key;            // set on rows that can go away (Bridge.ring-row)
    callback clicked;

    height: Style.row-h;
    border-radius: Style.gap;
    background: ta.pressed ? Style.row-pressed
              : root.selected ? Style.row-on : Style.row;
    border-width: fs.has-focus ? 4px : root.selected ? 2px : 0px;
    border-color: fs.has-focus ? Style.focus : Style.edge;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-gained => {
            if (root.ring-key != "") {
                Bridge.ring-row = root.ring-key;
            }
        }
        focus-lost => {
            if (root.ring-key != "" && Bridge.ring-row == root.ring-key) {
                Bridge.ring-row = "";
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: Style.gap * 3;
        padding-right: Style.gap * 3;
        spacing: Style.gap * 2;
        Text {
            text: root.label;
            color: Style.text;
            font-size: Style.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Style.dim;
            font-size: Style.font;
            vertical-alignment: center;
        }
    }
}

// A square button inside a row (the volume -/+). Focusable on its own, like
// a Row: the keyboard ring reaches it and Enter presses it.
component StepButton inherits Rectangle {
    in property <string> label;
    in property <int> index;                  // 0 "-", 1 "+" (Bridge.stepper-focus)
    callback clicked;

    width: Style.row-h - Style.gap * 2;
    height: Style.row-h - Style.gap * 2;
    border-radius: Style.gap;
    background: ta.pressed ? Style.row-pressed : Style.bg;
    border-width: fs.has-focus ? 4px : 1px;
    border-color: fs.has-focus ? Style.focus : Style.edge;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-gained => {
            Bridge.stepper-focus = root.index;
        }
        focus-lost => {
            if (Bridge.stepper-focus == root.index) {
                Bridge.stepper-focus = -1;
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Style.text;
        font-size: 40px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A row holding a level: label, value, and -/+ buttons (the row itself is
// not a button, so a tap beside them does nothing).
component StepperRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback decrease;
    callback increase;

    height: Style.row-h;
    border-radius: Style.gap;
    background: Style.row;

    HorizontalLayout {
        padding-left: Style.gap * 3;
        padding-right: Style.gap;
        spacing: Style.gap * 2;
        alignment: stretch;
        Text {
            text: root.label;
            color: Style.text;
            font-size: Style.font;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Style.dim;
            font-size: Style.font;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            StepButton { label: "-"; index: 0; clicked => { root.decrease(); } }
        }
        VerticalLayout {
            alignment: center;
            StepButton { label: "+"; index: 1; clicked => { root.increase(); } }
        }
    }
}

// Where the volume bar sits. Over live video C++ shows exactly this
// rectangle of the overlay plane (a window composited by the display
// engine), so the bar is a plain opaque rectangle: RGB565 has no alpha, and
// rounded corners would show whatever screen lies beneath in the buffer.
export global VolumeBar {
    out property <length> x: 160px;
    out property <length> y: 392px;
    out property <length> width: 480px;
    out property <length> height: 64px;
}

component VolumeBarView inherits Rectangle {
    x: VolumeBar.x;
    y: VolumeBar.y;
    width: VolumeBar.width;
    height: VolumeBar.height;
    background: Style.bg;
    border-width: 2px;
    border-color: Style.edge;

    HorizontalLayout {
        padding-left: Style.gap * 3;
        padding-right: Style.gap * 3;
        spacing: Style.gap * 2;
        Text {
            text: "Volume";
            color: Style.text;
            font-size: Style.font;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 12px;
                background: Style.row;
                Rectangle {
                    x: 0;
                    width: Bridge.volume-muted ? 0 : parent.width * Bridge.volume-level / 100;
                    height: parent.height;
                    background: Style.row-on;
                }
            }
        }
        Text {
            text: Bridge.volume-label;
            color: Bridge.volume-muted ? Style.dim : Style.text;
            font-size: Style.font;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 64px;
        }
    }
}

// Dim caption line at the top of a screen.
component Header inherits Text {
    color: Style.dim;
    font-size: Style.font;
    height: 34px;
    vertical-alignment: center;
    overflow: elide;
}

// How the phone is connected: 24 px line drawings in the text color (drawn
// here, so no icon font is needed). Shown only while that link is up.
component IconBluetooth inherits Path {
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: Style.text;
    stroke-width: 2px;
    commands: "M7 7 L17 17 L12 22 L12 2 L17 7 L7 17";
}

component IconWifi inherits Rectangle {
    width: 24px;
    height: 24px;
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Style.text;
        stroke-width: 2px;
        commands: "M2.5 9.5 A14 14 0 0 1 21.5 9.5 M5.5 13 A9.5 9.5 0 0 1 18.5 13 M8.5 16.5 A5 5 0 0 1 15.5 16.5";
    }
    Rectangle {
        x: 10.5px;
        y: 18.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: Style.text;
    }
}

component IconUsb inherits Rectangle {
    width: 24px;
    height: 24px;
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Style.text;
        stroke-width: 2px;
        commands: "M12 4 L12 19 M12 15 L7 11 L7 9 M12 12 L17 9 L17 7.5";
    }
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Style.text;
        commands: "M12 1 L9 5 L15 5 Z";
    }
    Rectangle { x: 15px; y: 4px; width: 4px; height: 4px; background: Style.text; }
    Rectangle { x: 5px; y: 6px; width: 4px; height: 4px; border-radius: 2px; background: Style.text; }
    Rectangle { x: 9.5px; y: 18px; width: 5px; height: 5px; border-radius: 2.5px; background: Style.text; }
}

// Full-screen scrollable column of rows.
component ListScreen inherits Flickable {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding: Style.gap;
        spacing: Style.gap;
        @children
    }
}

// ── screens ──────────────────────────────────────────────────────────────
// Screen ids: see Bridge.screen.

component ScreenHome inherits ListScreen {
    callback goto(int);
    HorizontalLayout {
        spacing: Style.gap * 2;
        padding-right: Style.gap;
        Header {
            text: Bridge.source-label + "  -  " + (Bridge.status == "" ? "ready" : Bridge.status);
            horizontal-stretch: 1;
        }
        if Bridge.link-usb: VerticalLayout {
            alignment: center;
            IconUsb { }
        }
        if Bridge.link-wifi: VerticalLayout {
            alignment: center;
            IconWifi { }
        }
        if Bridge.link-bt: VerticalLayout {
            alignment: center;
            IconBluetooth { }
        }
    }
    if Bridge.session-waiting: Row {
        // The hero: twice a normal row, so it is unmistakable at a glance
        // and an easy target on a moving vehicle.
        height: Style.row-h * 2;
        label: "Resume";
        ring-key: "resume";
        selected: true;
        clicked => { Bridge.resume(); }
    }
    Row { label: "Settings"; clicked => { root.goto(1); } }
}

component ScreenSettings inherits ListScreen {
    callback goto(int);
    Header { text: Bridge.restart-needed ? "Settings  -  restart to apply" : "Settings"; }
    // Back at the top (below the header) -- easier to reach on a car screen.
    // Only four rows fit above the fold: Audio, the one used on the road,
    // then the connectivity rows.
    Row { label: "Back"; clicked => { root.goto(0); } }
    Row { label: "Audio"; value: Bridge.volume-label; clicked => { root.goto(6); } }
    Row { label: "Source"; value: Bridge.source-label; clicked => { root.goto(2); } }
    Row { label: "Wireless"; clicked => { root.goto(3); } }
    Row { label: "Night"; value: Bridge.night-label; clicked => { Bridge.cycle-night(); } }
    Row { label: "Video"; value: Bridge.fps-label; clicked => { root.goto(8); } }
    Row { label: "System"; clicked => { root.goto(7); } }
    // Only meaningful once something needs it; hidden otherwise rather than
    // inviting a pointless restart.
    if Bridge.restart-needed: Row { label: "Restart now"; clicked => { Bridge.restart-now(); } }
}

component ScreenSource inherits ListScreen {
    callback goto(int);
    Header { text: "Source"; }
    Row { label: "Back"; clicked => { root.goto(1); } }
    // Protocol ids match ui_bridge::Protocol. Selecting stages the change
    // (persist + "restart to apply"); it never drops a live session.
    for src in [
        { id: 1, label: "AA Wired" },
        { id: 2, label: "AA Wireless" },
        { id: 3, label: "CarPlay Wired" },
        { id: 4, label: "CarPlay Wireless" },
    ]: Row {
        label: src.label;
        selected: Bridge.protocol == src.id;
        value: Bridge.protocol == src.id ? "Active" : "";
        clicked => { Bridge.select-protocol(src.id); }
    }
}

// The phone's frame rate, and the camera: Test camera shows it full screen
// (a tap or any key closes it); the rest applies at its next start.
component ScreenVideo inherits ListScreen {
    callback goto(int);
    Header { text: Bridge.restart-needed ? "Video  -  restart to apply" : "Video"; }
    Row { label: "Back"; clicked => { root.goto(1); } }
    Row { label: "Frame rate"; value: Bridge.fps-label; clicked => { Bridge.cycle-fps(); } }
    if Bridge.camera-available: Header { text: "Camera"; }
    if Bridge.camera-available: Row {
        label: "Test camera";
        value: Bridge.camera-error;
        clicked => { root.goto(9); }
    }
    if Bridge.camera-available && Bridge.camera-input-label != "": Row {
        label: "Input";
        value: Bridge.camera-input-label;
        clicked => { Bridge.camera-cycle-input(); }
    }
    if Bridge.camera-available: Row {
        label: "Standard";
        value: Bridge.camera-standard-label;
        clicked => { Bridge.camera-cycle-standard(); }
    }
    if Bridge.camera-available && Bridge.camera-brightness-label != "": StepperRow {
        label: "Brightness";
        value: Bridge.camera-brightness-label;
        decrease => { Bridge.camera-step(0, -1); }
        increase => { Bridge.camera-step(0, 1); }
    }
    if Bridge.camera-available && Bridge.camera-contrast-label != "": StepperRow {
        label: "Contrast";
        value: Bridge.camera-contrast-label;
        decrease => { Bridge.camera-step(1, -1); }
        increase => { Bridge.camera-step(1, 1); }
    }
    if Bridge.camera-available && Bridge.camera-saturation-label != "": StepperRow {
        label: "Saturation";
        value: Bridge.camera-saturation-label;
        decrease => { Bridge.camera-step(2, -1); }
        increase => { Bridge.camera-step(2, 1); }
    }
}

// Test camera: the camera is on the video plane below and the overlay is
// hidden, except for the hint window (the volume bar's place) for a moment.
// The whole screen is a tap target that closes it; keys close it from C++.
component ScreenCamera inherits Rectangle {
    callback goto(int);
    background: #000000;
    TouchArea { clicked => { root.goto(8); } }
    if Bridge.camera-hint: Rectangle {
        x: VolumeBar.x;
        y: VolumeBar.y;
        width: VolumeBar.width;
        height: VolumeBar.height;
        background: Style.bg;
        border-width: 2px;
        border-color: Style.edge;
        Text {
            text: "Tap or press any key to close";
            color: Style.text;
            font-size: Style.font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Reboot and shut down. Each asks first, in the dialog; the app then closes
// down cleanly and the system's own reboot / poweroff takes over.
component ScreenSystem inherits ListScreen {
    callback goto(int);
    Header { text: "System"; }
    Row { label: "Back"; clicked => { root.goto(1); } }
    Row { label: "Reboot"; clicked => { Bridge.system-ask(1); } }
    Row { label: "Shut down"; clicked => { Bridge.system-ask(2); } }
}

component ScreenAudio inherits ListScreen {
    callback goto(int);
    Header { text: "Audio"; }
    Row { label: "Back"; clicked => { root.goto(1); } }
    // The level shows while muted too: a volume key unmutes from there.
    StepperRow {
        label: "Volume";
        value: Bridge.volume-level + "%";
        decrease => { Bridge.volume-step(-1); }
        increase => { Bridge.volume-step(1); }
    }
    Row {
        label: "Mute";
        value: Bridge.volume-muted ? "On" : "Off";
        selected: Bridge.volume-muted;
        clicked => { Bridge.volume-mute(); }
    }
}

component ScreenWireless inherits ListScreen {
    callback goto(int);
    Header { text: Bridge.restart-needed ? "Wireless  -  restart to apply" : "Wireless"; }
    Row { label: "Back"; clicked => { root.goto(1); } }
    Row { label: "Name"; value: Bridge.wifi-ssid; clicked => { Bridge.edit-field(0); } }
    Row { label: "Password"; value: Bridge.wifi-pass; clicked => { Bridge.edit-field(1); } }
    Row { label: "BT name"; value: Bridge.bt-name; clicked => { Bridge.edit-field(2); } }
    if Bridge.bt-available: Row {
        label: "Bluetooth";
        value: Bridge.bt-summary;
        clicked => { root.goto(4); }
    }
}

// Paired keyboards/remotes, and pairing new ones. Phones are not listed:
// they pair from their own Bluetooth settings, as before.
component ScreenBluetooth inherits ListScreen {
    callback goto(int);
    Header { text: Bridge.bt-status == "" ? "Bluetooth devices" : "Bluetooth  -  " + Bridge.bt-status; }
    Row { label: "Back"; clicked => { root.goto(3); } }
    Row {
        label: Bridge.bt-scanning ? "Stop searching" : "Add device";
        value: !Bridge.bt-scan-allowed ? "Not during a session"
             : Bridge.bt-scanning ? "Searching..." : "";
        selected: Bridge.bt-scanning;
        clicked => { Bridge.bt-scan(!Bridge.bt-scanning); }
    }
    for d in Bridge.bt-paired: Row {
        label: d.name;
        value: d.detail;
        ring-key: "paired:" + d.id;
        selected: d.connected;
        clicked => {
            Bridge.bt-open(d.id);
            root.goto(5);
        }
    }
    if Bridge.bt-found.length > 0: Header { text: "Found - tap to pair"; }
    for d in Bridge.bt-found: Row {
        label: d.name;
        value: d.detail;
        ring-key: "found:" + d.id;
        clicked => { Bridge.bt-pair(d.id); }
    }
}

component ScreenBtDevice inherits ListScreen {
    callback goto(int);
    Header { text: Bridge.bt-current.name; }
    Row { label: "Back"; clicked => { root.goto(4); } }
    Row {
        label: Bridge.bt-current.connected ? "Disconnect" : "Connect";
        value: Bridge.bt-current.detail;
        clicked => { Bridge.bt-connect(Bridge.bt-current.id, !Bridge.bt-current.connected); }
    }
    Row { label: "Forget"; clicked => { Bridge.bt-forget(Bridge.bt-current.id); } }
}

// ── full-screen text editor with an on-screen keyboard ──────────────────
component OskKey inherits Rectangle {
    in property <string> label;
    in property <float> weight: 1;
    in property <bool> focused; // the keyboard ring is on this key
    callback pressed;
    horizontal-stretch: root.weight;
    border-radius: 6px;
    background: ta.pressed ? Style.row-pressed : Style.row;
    border-width: root.focused ? 4px : 0px;
    border-color: Style.focus;
    ta := TouchArea { clicked => { root.pressed(); } }
    Text {
        text: root.label;
        color: Style.text;
        font-size: Style.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Keys and their ring positions follow Osk (row, col) -- keep the two in step.
component Editor inherits Rectangle {
    background: Style.bg;

    VerticalLayout {
        padding: Style.gap;
        spacing: Style.gap;

        // Title: what is being edited (or the red validation error), and an
        // explicit way out -- text entry must always be abandonable.
        HorizontalLayout {
            height: 44px;
            spacing: Style.gap;
            Text {
                text: Bridge.editor-error == "" ? Bridge.editor-label : Bridge.editor-error;
                color: Bridge.editor-error == "" ? Style.dim : #EF5350;
                font-size: Style.font;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            OskKey { label: "Cancel"; focused: Osk.row == 0; pressed => { Bridge.osk-cancel(); } }
        }

        // The value being edited, with a plain underscore caret.
        Rectangle {
            height: 52px;
            border-radius: Style.gap;
            background: #0B0E11;
            border-width: 1px;
            border-color: Style.edge;
            Text {
                x: Style.gap * 2;
                width: parent.width - Style.gap * 4;
                text: Bridge.editor-text + "_";
                color: Style.text;
                font-size: Style.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            for k[i] in Osk.r1: OskKey {
                label: k;
                focused: Osk.row == 1 && Osk.col == i;
                pressed => { Bridge.osk-key(k); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for k[i] in Osk.r2: OskKey {
                label: k;
                focused: Osk.row == 2 && Osk.col == i;
                pressed => { Bridge.osk-key(k); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            if !Osk.symbols: OskKey {
                label: "Shift"; weight: 1.5;
                focused: Osk.row == 3 && Osk.col == 0;
                pressed => { Osk.shift = !Osk.shift; }
            }
            for k[i] in Osk.r3: OskKey {
                label: k;
                focused: Osk.row == 3 && Osk.col == Osk.r3-first + i;
                pressed => { Bridge.osk-key(k); }
            }
            OskKey {
                label: "Del"; weight: 1.5;
                focused: Osk.row == 3 && Osk.col == Osk.r3-first + Osk.r3.length;
                pressed => { Bridge.osk-backspace(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            OskKey {
                label: Osk.symbols ? "abc" : "?123"; weight: 1.5;
                focused: Osk.row == 4 && Osk.col == 0;
                pressed => { Osk.symbols = !Osk.symbols; Osk.shift = false; }
            }
            // The backtick is outside the compiler's default glyph set: this
            // key embeds it, so one typed on a keyboard is drawn too.
            if Osk.symbols: OskKey {
                label: "`";
                focused: Osk.row == 4 && Osk.col == 1;
                pressed => { Bridge.osk-key("`"); }
            }
            OskKey {
                label: ",";
                focused: Osk.row == 4 && Osk.col == 1 + Osk.r4-extra;
                pressed => { Bridge.osk-key(","); }
            }
            OskKey {
                label: "Space"; weight: 3;
                focused: Osk.row == 4 && Osk.col == 2 + Osk.r4-extra;
                pressed => { Bridge.osk-key(" "); }
            }
            OskKey {
                label: ".";
                focused: Osk.row == 4 && Osk.col == 3 + Osk.r4-extra;
                pressed => { Bridge.osk-key("."); }
            }
            OskKey {
                label: "OK"; weight: 1.5;
                focused: Osk.row == 4 && Osk.col == 4 + Osk.r4-extra;
                pressed => { Bridge.osk-ok(); }
            }
        }
    }
}

// ── pairing / confirmation dialog ────────────────────────────────────────
// Like the editor, a full-screen replacement opened and closed only by C++.
// The code is large: it is typed on a keyboard held away from the screen.
component Prompt inherits Rectangle {
    background: Style.bg;
    VerticalLayout {
        padding: Style.gap * 2;
        spacing: Style.gap * 2;
        Header { text: Bridge.prompt-title; }
        if Bridge.prompt-code != "": Rectangle {
            height: 96px;
            border-radius: Style.gap;
            background: #0B0E11;
            border-width: 1px;
            border-color: Style.edge;
            Text {
                text: Bridge.prompt-code;
                color: Style.text;
                font-size: 40px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: Bridge.prompt-hint;
            color: Style.text;
            font-size: Style.font;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            height: Style.row-h;
            spacing: Style.gap;
            if Bridge.prompt-kind == 2: OskKey {
                label: Bridge.prompt-accept-label;
                focused: Bridge.prompt-focus == 0;
                pressed => { Bridge.prompt-accept(); }
            }
            OskKey {
                label: "Cancel";
                focused: Bridge.prompt-focus == 1;
                pressed => { Bridge.prompt-cancel(); }
            }
        }
    }
}

// ── root ─────────────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    background: Style.bg;
    default-font-family: "Open Sans";

    // A dialog replaces the screen. The pairing prompt has a deadline, so it
    // wins over the editor (whose buffer survives in C++).
    property <bool> modal: Bridge.prompt-kind != 0 || Bridge.editing >= 0;

    // The Back key: one level up. C++ calls it directly so Back never
    // depends on keyboard focus; false means "already home".
    public function back() -> bool {
        if (Bridge.screen == 0) {
            return false;
        }
        // Bluetooth device -> Bluetooth -> Wireless; the camera view -> Video;
        // the rest -> Settings -> Home.
        Bridge.screen = Bridge.screen == 5 ? 4 : Bridge.screen == 4 ? 3 : Bridge.screen == 9 ? 8
            : Bridge.screen >= 2 ? 1 : 0;
        return true;
    }

    if Bridge.screen == 0 && !root.modal: ScreenHome      { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 1 && !root.modal: ScreenSettings  { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 2 && !root.modal: ScreenSource    { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 3 && !root.modal: ScreenWireless  { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 4 && !root.modal: ScreenBluetooth { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 5 && !root.modal: ScreenBtDevice  { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 6 && !root.modal: ScreenAudio     { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 7 && !root.modal: ScreenSystem    { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 8 && !root.modal: ScreenVideo     { goto(s) => { Bridge.screen = s; } }
    if Bridge.screen == 9 && !root.modal: ScreenCamera    { goto(s) => { Bridge.screen = s; } }
    if Bridge.prompt-kind != 0: Prompt {}
    if Bridge.prompt-kind == 0 && Bridge.editing >= 0: Editor {}
    // Over everything, including dialogs; display only (no input).
    if Bridge.volume-bar: VolumeBarView {}
}
